@@ -19,8 +19,20 @@ export async function loadServerSettings(): Promise<ServerConfig | null> {
   }
 }
 
+/** Restore endpoints before probing the session; never send a token to defaults. */
+export async function restoreServerSession(): Promise<ServerConfig | null> {
+  const saved = await loadServerSettings();
+  if (!saved) return null;
+  setServerConfig(saved);
+  await useAuthStore.getState().initialize();
+  return saved;
+}
+
 /** No app/auth providers are mounted until this transaction succeeds. */
 export async function connectServer(value: ServerConfig): Promise<void> {
+  if (useAuthStore.getState().user) {
+    throw new Error("Sign out before changing the server");
+  }
   const next = normalizeServerConfig(value);
   const previous = await loadServerSettings();
   // An unbound (pre-settings) token must never be forwarded to a new host.
