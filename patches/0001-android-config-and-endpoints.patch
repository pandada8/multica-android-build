diff --git a/apps/mobile/lib/server-config.test.ts b/apps/mobile/lib/server-config.test.ts
new file mode 100644
index 000000000..5aa2d48e0
--- /dev/null
+++ b/apps/mobile/lib/server-config.test.ts
@@ -0,0 +1,43 @@
+// @vitest-environment node
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+afterEach(() => {
+  vi.unstubAllEnvs();
+  vi.resetModules();
+});
+async function config(
+  api: string | undefined,
+  site = "https://site.example.test/",
+) {
+  vi.stubEnv("EXPO_PUBLIC_API_URL", api);
+  vi.stubEnv("EXPO_PUBLIC_WEB_URL", site);
+  return import("./server-config");
+}
+describe("server endpoints", () => {
+  it("normalizes independent API and site URLs", async () => {
+    const value = await config(
+      "HTTPS://API.EXAMPLE.TEST///",
+      "https://site.example.test/base/",
+    );
+    expect(value.API_URL).toBe("https://api.example.test");
+    expect(value.SITE_URL).toBe("https://site.example.test/base");
+  });
+  it("accepts an HTTP API for a self-hosted server", async () => {
+    expect((await config("http://192.168.1.10:8080/")).API_URL).toBe("http://192.168.1.10:8080");
+  });
+  it.each([
+    undefined,
+    "",
+    "file:///tmp/x",
+    "https://u:p@example.test",
+    "https://example.test?q=1",
+    "https://example.test/#fragment",
+  ])("rejects invalid API URL %s", async (url) => {
+    await expect(config(url)).rejects.toThrow();
+  });
+  it("rejects an invalid site URL independently", async () => {
+    await expect(
+      config("https://api.example.test", "javascript:alert(1)"),
+    ).rejects.toThrow();
+  });
+});
diff --git a/apps/mobile/lib/server-config.ts b/apps/mobile/lib/server-config.ts
new file mode 100644
index 000000000..a7f6cd234
--- /dev/null
+++ b/apps/mobile/lib/server-config.ts
@@ -0,0 +1,26 @@
+/** Build-time endpoints shared by HTTP, WebSocket, attachments and site links. */
+function endpoint(value: string | undefined, name: string): string {
+  if (!value) throw new Error(`${name} is required`);
+  const url = new URL(value);
+  if (
+    !["https:", "http:"].includes(url.protocol) ||
+    url.username ||
+    url.password ||
+    url.search ||
+    url.hash
+  ) {
+    throw new Error(
+      `${name} must be an HTTP(S) URL without credentials, query or fragment`,
+    );
+  }
+  return url.toString().replace(/\/+$/, "");
+}
+
+export const API_URL = endpoint(
+  process.env.EXPO_PUBLIC_API_URL,
+  "EXPO_PUBLIC_API_URL",
+);
+export const SITE_URL = endpoint(
+  process.env.EXPO_PUBLIC_WEB_URL,
+  "EXPO_PUBLIC_WEB_URL",
+);
