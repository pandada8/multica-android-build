diff --git a/apps/mobile/data/server-settings.test.ts b/apps/mobile/data/server-settings.test.ts
new file mode 100644
index 000000000..01d21c226
--- /dev/null
+++ b/apps/mobile/data/server-settings.test.ts
@@ -0,0 +1,117 @@
+// @vitest-environment node
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const mocks = vi.hoisted(() => {
+  process.env.EXPO_PUBLIC_API_URL = "https://old.example.test";
+  process.env.EXPO_PUBLIC_WEB_URL = "https://old-site.example.test";
+  return {
+    get: vi.fn(),
+    save: vi.fn(),
+    logout: vi.fn(),
+    clearWorkspace: vi.fn(),
+    cancelQueries: vi.fn(),
+    clearQueries: vi.fn(),
+  };
+});
+vi.mock("expo-secure-store", () => ({
+  getItemAsync: mocks.get,
+  setItemAsync: mocks.save,
+}));
+vi.mock("./auth-store", () => ({
+  useAuthStore: {
+    setState: vi.fn(),
+    getState: () => ({ logout: mocks.logout }),
+  },
+}));
+vi.mock("./workspace-store", () => ({
+  useWorkspaceStore: { getState: () => ({ clear: mocks.clearWorkspace }) },
+}));
+vi.mock("./query-client", () => ({
+  queryClient: {
+    cancelQueries: mocks.cancelQueries,
+    clear: mocks.clearQueries,
+  },
+}));
+import { connectServer, loadServerSettings } from "./server-settings";
+import { API_URL, SITE_URL, setServerConfig } from "@/lib/server-config";
+const old = {
+  apiUrl: "https://old.example.test",
+  siteUrl: "https://old-site.example.test",
+};
+const next = {
+  apiUrl: "http://192.168.1.2:8080",
+  siteUrl: "https://site.example.test",
+};
+beforeEach(() => {
+  vi.resetAllMocks();
+  mocks.get.mockResolvedValue(JSON.stringify(old));
+  setServerConfig(old);
+});
+describe("startup server selection", () => {
+  it("clears the old session before persisting or enabling a new server", async () => {
+    const order: string[] = [];
+    mocks.logout.mockImplementation(async () => {
+      expect(API_URL).toBe(old.apiUrl);
+      order.push("logout");
+    });
+    mocks.clearWorkspace.mockImplementation(async () => {
+      order.push("workspace");
+    });
+    mocks.cancelQueries.mockImplementation(async () => {
+      order.push("cancel");
+    });
+    mocks.clearQueries.mockImplementation(() => {
+      order.push("cache");
+    });
+    mocks.save.mockImplementation(async () => {
+      expect(API_URL).toBe(old.apiUrl);
+      order.push("save");
+    });
+    await connectServer(next);
+    expect(order).toEqual(["logout", "workspace", "cancel", "cache", "save"]);
+    expect(API_URL).toBe(next.apiUrl);
+    expect(SITE_URL).toBe(next.siteUrl);
+    expect(mocks.save).toHaveBeenCalledWith(
+      "multica_server_config",
+      JSON.stringify(next),
+    );
+  });
+  it("preserves the session when reopening the same normalized server", async () => {
+    await connectServer({
+      apiUrl: old.apiUrl + "/",
+      siteUrl: old.siteUrl + "/",
+    });
+    expect(mocks.logout).not.toHaveBeenCalled();
+  });
+  it.each([
+    null,
+    "bad json",
+    JSON.stringify({ apiUrl: "javascript:bad", siteUrl: old.siteUrl }),
+  ])(
+    "discards unbound sessions for missing/corrupt settings %s",
+    async (saved) => {
+      mocks.get.mockResolvedValue(saved);
+      expect(await loadServerSettings()).toBeNull();
+      await connectServer(next);
+      expect(mocks.logout).toHaveBeenCalledOnce();
+    },
+  );
+  it("does not switch endpoints when credential deletion fails", async () => {
+    mocks.logout.mockRejectedValue(new Error("secure store unavailable"));
+    await expect(connectServer(next)).rejects.toThrow();
+    expect(API_URL).toBe(old.apiUrl);
+    expect(mocks.save).not.toHaveBeenCalled();
+  });
+  it("does not switch endpoints when saving fails", async () => {
+    mocks.save.mockRejectedValue(new Error("disk full"));
+    await expect(connectServer(next)).rejects.toThrow();
+    expect(API_URL).toBe(old.apiUrl);
+  });
+  it("rejects invalid input before touching the saved session", async () => {
+    await expect(
+      connectServer({ ...next, apiUrl: "file:///bad" }),
+    ).rejects.toThrow();
+    expect(mocks.logout).not.toHaveBeenCalled();
+    expect(mocks.save).not.toHaveBeenCalled();
+  });
+});
