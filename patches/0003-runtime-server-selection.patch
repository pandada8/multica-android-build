diff --git a/apps/mobile/components/auth/server-gate.tsx b/apps/mobile/components/auth/server-gate.tsx
new file mode 100644
index 000000000..ba63b82ca
--- /dev/null
+++ b/apps/mobile/components/auth/server-gate.tsx
@@ -0,0 +1,166 @@
+import {
+  createContext,
+  useContext,
+  useEffect,
+  useRef,
+  useState,
+  type ReactNode,
+} from "react";
+import { KeyboardAvoidingView, Platform, ScrollView, View } from "react-native";
+import { SafeAreaView } from "react-native-safe-area-context";
+import { Text } from "@/components/ui/text";
+import { TextField } from "@/components/ui/text-field";
+import { Button } from "@/components/ui/button";
+import { MulticaLogo } from "@/components/brand/multica-logo";
+import { useT } from "@/lib/i18n";
+import {
+  DEFAULT_SERVER_CONFIG,
+  normalizeServerConfig,
+} from "@/lib/server-config";
+import { connectServer, loadServerSettings } from "@/data/server-settings";
+
+const ServerSettingsContext = createContext(() => {});
+export const useServerSettings = () => useContext(ServerSettingsContext);
+
+export function ServerGate({ children }: { children: ReactNode }) {
+  const { t } = useT("auth");
+  const [ready, setReady] = useState(false);
+  const [loaded, setLoaded] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const submitting = useRef(false);
+  const [apiUrl, setApiUrl] = useState(DEFAULT_SERVER_CONFIG.apiUrl);
+  const [siteUrl, setSiteUrl] = useState(DEFAULT_SERVER_CONFIG.siteUrl);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    let active = true;
+    void loadServerSettings()
+      .then((saved) => {
+        if (!active) return;
+        if (saved) {
+          setApiUrl(saved.apiUrl);
+          setSiteUrl(saved.siteUrl);
+        }
+      })
+      .catch(() => {
+        if (active) setError(t("server.storage_error"));
+      })
+      .finally(() => {
+        if (active) setLoaded(true);
+      });
+    return () => {
+      active = false;
+    };
+  }, [t]);
+
+  const connect = async () => {
+    if (!loaded || submitting.current) return;
+    let next;
+    try {
+      next = normalizeServerConfig({ apiUrl, siteUrl });
+    } catch {
+      setError(t("server.invalid_url"));
+      return;
+    }
+    submitting.current = true;
+    setBusy(true);
+    setError(null);
+    try {
+      await connectServer(next);
+      setApiUrl(next.apiUrl);
+      setSiteUrl(next.siteUrl);
+      setReady(true);
+    } catch {
+      setError(t("server.storage_error"));
+    } finally {
+      submitting.current = false;
+      setBusy(false);
+    }
+  };
+
+  return (
+    <ServerSettingsContext.Provider value={() => setReady(false)}>
+      {ready ? (
+        children
+      ) : (
+        <SafeAreaView className="flex-1 bg-background">
+          <KeyboardAvoidingView
+            className="flex-1"
+            behavior={Platform.OS === "ios" ? "padding" : undefined}
+          >
+            <ScrollView
+              keyboardShouldPersistTaps="handled"
+              contentContainerStyle={{
+                flexGrow: 1,
+                justifyContent: "center",
+                padding: 24,
+              }}
+            >
+              <View className="gap-6">
+                <View className="items-center gap-3">
+                  <MulticaLogo size={32} />
+                  <Text className="text-2xl font-semibold">
+                    {t("server.title")}
+                  </Text>
+                </View>
+                <View className="gap-2">
+                  <Text>{t("server.api_url")}</Text>
+                  <TextField
+                    accessibilityLabel={t("server.api_url")}
+                    value={apiUrl}
+                    onChangeText={setApiUrl}
+                    autoCapitalize="none"
+                    autoCorrect={false}
+                    keyboardType="url"
+                    editable={loaded && !busy}
+                  />
+                </View>
+                <View className="gap-2">
+                  <Text>{t("server.site_url")}</Text>
+                  <TextField
+                    accessibilityLabel={t("server.site_url")}
+                    value={siteUrl}
+                    onChangeText={setSiteUrl}
+                    autoCapitalize="none"
+                    autoCorrect={false}
+                    keyboardType="url"
+                    editable={loaded && !busy}
+                    onSubmitEditing={connect}
+                    returnKeyType="go"
+                  />
+                </View>
+                <Text className="text-sm text-muted-foreground">
+                  {t("server.session_notice")}
+                </Text>
+                {/^http:/i.test(apiUrl.trim()) ? (
+                  <Text className="text-sm text-muted-foreground">
+                    {t("server.http_notice")}
+                  </Text>
+                ) : null}
+                {error ? (
+                  <Text
+                    accessibilityRole="alert"
+                    className="text-sm text-destructive"
+                  >
+                    {error}
+                  </Text>
+                ) : null}
+                <Button
+                  size="lg"
+                  disabled={
+                    !loaded || busy || !apiUrl.trim() || !siteUrl.trim()
+                  }
+                  onPress={connect}
+                >
+                  <Text>
+                    {busy ? t("server.saving") : t("server.continue")}
+                  </Text>
+                </Button>
+              </View>
+            </ScrollView>
+          </KeyboardAvoidingView>
+        </SafeAreaView>
+      )}
+    </ServerSettingsContext.Provider>
+  );
+}
