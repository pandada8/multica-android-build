index 000000000..3b4c66ddb
--- /dev/null
+++ b/apps/mobile/data/server-settings.ts
@@ -0,0 +1,40 @@
+import * as SecureStore from "expo-secure-store";
+import {
+  normalizeServerConfig,
+  setServerConfig,
+  type ServerConfig,
+} from "@/lib/server-config";
+import { useAuthStore } from "./auth-store";
+import { useWorkspaceStore } from "./workspace-store";
+import { queryClient } from "./query-client";
+
+const KEY = "multica_server_config";
+export async function loadServerSettings(): Promise<ServerConfig | null> {
+  const raw = await SecureStore.getItemAsync(KEY);
+  if (!raw) return null;
+  try {
+    return normalizeServerConfig(JSON.parse(raw));
+  } catch {
+    return null;
+  }
+}
+
+/** No app/auth providers are mounted until this transaction succeeds. */
+export async function connectServer(value: ServerConfig): Promise<void> {
+  const next = normalizeServerConfig(value);
+  const previous = await loadServerSettings();
+  // An unbound (pre-settings) token must never be forwarded to a new host.
+  if (
+    !previous ||
+    previous.apiUrl !== next.apiUrl ||
+    previous.siteUrl !== next.siteUrl
+  ) {
+    await useAuthStore.getState().logout();
+    await useWorkspaceStore.getState().clear();
+    await queryClient.cancelQueries();
+    queryClient.clear();
+  }
+  await SecureStore.setItemAsync(KEY, JSON.stringify(next));
+  setServerConfig(next);
+  useAuthStore.setState({ isLoading: true });
+}
diff --git a/apps/mobile/lib/server-config.ts b/apps/mobile/lib/server-config.ts
index a7f6cd234..e8392085d 100644
--- a/apps/mobile/lib/server-config.ts
+++ b/apps/mobile/lib/server-config.ts
@@ -1,4 +1,4 @@
-/** Build-time endpoints shared by HTTP, WebSocket, attachments and site links. */
+/** Live endpoints shared by HTTP, WebSocket, attachments and site links. */
 function endpoint(value: string | undefined, name: string): string {
   if (!value) throw new Error(`${name} is required`);
   const url = new URL(value);
@@ -16,11 +16,44 @@ function endpoint(value: string | undefined, name: string): string {
   return url.toString().replace(/\/+$/, "");
 }
 
-export const API_URL = endpoint(
+export let API_URL = endpoint(
   process.env.EXPO_PUBLIC_API_URL,
   "EXPO_PUBLIC_API_URL",
 );
-export const SITE_URL = endpoint(
+export let SITE_URL = endpoint(
   process.env.EXPO_PUBLIC_WEB_URL,
   "EXPO_PUBLIC_WEB_URL",
 );
+
+export interface ServerConfig {
+  apiUrl: string;
+  siteUrl: string;
+}
+export const DEFAULT_SERVER_CONFIG: Readonly<ServerConfig> = Object.freeze({
+  apiUrl: API_URL,
+  siteUrl: SITE_URL,
+});
+
+export function normalizeServerConfig(value: unknown): ServerConfig {
+  if (
+    !value ||
+    typeof value !== "object" ||
+    !("apiUrl" in value) ||
+    !("siteUrl" in value) ||
+    typeof value.apiUrl !== "string" ||
+    typeof value.siteUrl !== "string"
+  ) {
+    throw new Error("Invalid server configuration");
+  }
+  return {
+    apiUrl: endpoint(value.apiUrl.trim(), "API URL"),
+    siteUrl: endpoint(value.siteUrl.trim(), "Site URL"),
+  };
+}
+
+/** Called only while the startup gate has unmounted all authenticated consumers. */
+export function setServerConfig(value: ServerConfig): void {
+  const next = normalizeServerConfig(value);
+  API_URL = next.apiUrl;
+  SITE_URL = next.siteUrl;
+}
