diff --git a/apps/mobile/components/ui/platform-image.tsx b/apps/mobile/components/ui/platform-image.tsx
new file mode 100644
index 000000000..d3c80674f
--- /dev/null
+++ b/apps/mobile/components/ui/platform-image.tsx
@@ -0,0 +1,38 @@
+import { Image as ExpoImage, type ImageProps } from "expo-image";
+import { MaterialIcons } from "@expo/vector-icons";
+import { Platform, StyleSheet } from "react-native";
+import type { ComponentProps } from "react";
+
+const symbols: Record<string, ComponentProps<typeof MaterialIcons>["name"]> = {
+  tray: "inbox",
+  "tray.fill": "inbox",
+  checklist: "checklist",
+  "checklist.unchecked": "checklist",
+  "bubble.left": "chat-bubble-outline",
+  "bubble.left.fill": "chat-bubble",
+  ellipsis: "more-horiz",
+  checkmark: "check",
+  "chevron.right": "chevron-right",
+  pin: "push-pin",
+  "list.bullet": "list",
+  "square.stack": "folder",
+};
+export function Image(props: ImageProps) {
+  if (
+    Platform.OS !== "ios" &&
+    typeof props.source === "string" &&
+    props.source.startsWith("sf:")
+  ) {
+    const style = StyleSheet.flatten(props.style);
+    return (
+      <MaterialIcons
+        name={symbols[props.source.slice(3)] ?? "help-outline"}
+        size={typeof style?.width === "number" ? style.width : 24}
+        color={props.tintColor ?? undefined}
+        style={props.style}
+        accessibilityLabel={props.accessibilityLabel}
+      />
+    );
+  }
+  return <ExpoImage {...props} />;
+}
diff --git a/apps/mobile/lib/action-sheet.tsx b/apps/mobile/lib/action-sheet.tsx
new file mode 100644
index 000000000..162cc4ee2
--- /dev/null
+++ b/apps/mobile/lib/action-sheet.tsx
@@ -0,0 +1,124 @@
+import { useSyncExternalStore } from "react";
+import {
+  ActionSheetIOS,
+  Modal,
+  Platform,
+  Pressable,
+  ScrollView,
+  Text,
+  View,
+} from "react-native";
+import type { ActionSheetIOSOptions } from "react-native";
+import { useColorScheme } from "@/lib/use-color-scheme";
+import { THEME } from "@/lib/theme";
+
+type Sheet = {
+  options: ActionSheetIOSOptions;
+  callback: (index: number) => void;
+};
+let current: Sheet | null = null;
+const listeners = new Set<() => void>();
+function emit() {
+  listeners.forEach((listener) => listener());
+}
+function finish(index: number) {
+  const sheet = current;
+  current = null;
+  emit();
+  sheet?.callback(index);
+}
+export function showActionSheet(
+  options: ActionSheetIOSOptions,
+  callback: (index: number) => void,
+) {
+  if (Platform.OS === "ios") {
+    ActionSheetIOS.showActionSheetWithOptions(options, callback);
+    return;
+  }
+  if (current) finish(current.options.cancelButtonIndex ?? -1);
+  current = { options, callback };
+  emit();
+}
+function subscribe(listener: () => void) {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+export function AndroidActionSheetHost() {
+  const sheet = useSyncExternalStore(subscribe, () => current);
+  const { colorScheme } = useColorScheme();
+  const theme = THEME[colorScheme];
+  if (!sheet) return null;
+  const cancel = () => finish(sheet.options.cancelButtonIndex ?? -1);
+  const destructive = sheet.options.destructiveButtonIndex;
+  return (
+    <Modal transparent visible animationType="fade" onRequestClose={cancel}>
+      <View style={{ flex: 1, justifyContent: "center", padding: 24 }}>
+        <Pressable
+          accessibilityLabel={
+            sheet.options.options[sheet.options.cancelButtonIndex ?? -1]
+          }
+          onPress={cancel}
+          style={{
+            position: "absolute",
+            top: 0,
+            left: 0,
+            right: 0,
+            bottom: 0,
+            backgroundColor: "rgba(0,0,0,0.5)",
+          }}
+        />
+        <View
+          accessibilityViewIsModal
+          style={{
+            backgroundColor: theme.background,
+            borderRadius: 12,
+            maxHeight: "80%",
+          }}
+        >
+          {sheet.options.title ? (
+            <Text style={{ color: theme.foreground, padding: 16 }}>
+              {sheet.options.title}
+            </Text>
+          ) : null}
+          {sheet.options.message ? (
+            <Text style={{ color: theme.foreground, padding: 16 }}>
+              {sheet.options.message}
+            </Text>
+          ) : null}
+          <ScrollView>
+            {sheet.options.options.map((label, index) => (
+              <Pressable
+                key={index}
+                accessibilityRole="button"
+                disabled={sheet.options.disabledButtonIndices?.includes(index)}
+                onPress={() => finish(index)}
+                style={{
+                  padding: 18,
+                  opacity: sheet.options.disabledButtonIndices?.includes(index)
+                    ? 0.4
+                    : 1,
+                }}
+              >
+                <Text
+                  style={{
+                    color: (
+                      Array.isArray(destructive)
+                        ? destructive.includes(index)
+                        : destructive === index
+                    )
+                      ? theme.destructive
+                      : theme.foreground,
+                  }}
+                >
+                  {label}
+                </Text>
+              </Pressable>
+            ))}
+          </ScrollView>
+        </View>
+      </View>
+    </Modal>
+  );
+}
