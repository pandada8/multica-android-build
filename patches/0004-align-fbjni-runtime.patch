@@ -0,0 +1,20 @@
+const { withProjectBuildGradle } = require("expo/config-plugins");
+
+// Match React Native 0.83.6's native runtime. Shiki requests fbjni:+, which
+// otherwise selects a newer binary requiring symbols absent from RN's libc++.
+module.exports = function withFbjniVersion(config) {
+  return withProjectBuildGradle(config, (config) => {
+    const marker = "// Multica: align fbjni with React Native";
+    if (!config.modResults.contents.includes(marker)) {
+      config.modResults.contents += `
+${marker}
+allprojects {
+  configurations.configureEach {
+    resolutionStrategy.force 'com.facebook.fbjni:fbjni:0.7.0'
+  }
+}
+`;
+    }
+    return config;
+  });
+};
